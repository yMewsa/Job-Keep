# Aplicacao
NODE_ENV=development
PORT=3000
APP_NAME=job-keep-api
LOG_LEVEL=debug

# Banco de dados (PostgreSQL)
DATABASE_URL=postgresql://jobkeep:jobkeep_dev_password@localhost:5432/job_keep?schema=public

# Redis (cache, filas e bloqueio de tentativas)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# Autenticacao JWT (substituir em producao por segredos fortes aleatorios)
JWT_ACCESS_SECRET=change_me_access_secret_with_at_least_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_with_at_least_32_characters
JWT_REFRESH_EXPIRES_DAYS=30

# Seguranca e CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# E-mail (Mailpit em desenvolvimento)
MAIL_PROVIDER=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Job Keep <no-reply@jobkeep.local>"
APP_PUBLIC_URL=http://localhost:3000

# Storage S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=job-keep-uploads
S3_ACCESS_KEY=jobkeep_minio
S3_SECRET_KEY=jobkeep_minio_password

# Politica de versao minima do app mobile
MIN_ANDROID_VERSION=0.1.0
RECOMMENDED_ANDROID_VERSION=0.1.0
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=br.com.jobkeep.mobile
MIN_IOS_VERSION=0.1.0
RECOMMENDED_IOS_VERSION=0.1.0
IOS_STORE_URL=https://apps.apple.com/app/job-keep/id0000000000

# Limite global de vagas ativas por empresa (pode ser sobrescrito por maxActiveJobs)
MAX_ACTIVE_JOBS_PER_COMPANY=10
